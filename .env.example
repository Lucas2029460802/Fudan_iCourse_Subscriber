# 复旦统一身份认证（必填）
StuId=your_student_id
UISPsw=your_password

# 要监控的课程 ID，多个用英文逗号分隔（必填才会处理录播）
COURSE_IDS=12345,67890

# 至少填写一个 LLM API Key
DASHSCOPE_API_KEY=your_dashscope_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
GEMINI_API_KEY=your_gemini_api_key

# QQ 邮箱 SMTP。SMTP_PASSWORD 填授权码，不是登录密码（要发邮件则必填）
SMTP_EMAIL=your_qq@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
RECEIVER_EMAIL=receiver@example.com

# 本地存储（可选，默认如下）
DATA_DIR=data
DB_PATH=data/icourse.db
OVERVIEW_DIR=overview

# 语音识别（可选，默认 SenseVoice）
ASR_BACKEND=sensevoice
ASR_MODEL_DIR=sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17
SILERO_VAD_PATH=silero_vad.onnx
ASR_NUM_THREADS=4
